# 可留空；启动后在网页“模型设置”中选择服务商、填写自己的 API Key
# 已有部署仍兼容以下 DeepSeek 环境配置；网页保存的配置优先
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-flash

# MySQL
MYSQL_DATABASE=mockinterview
MYSQL_USER=mock
MYSQL_PASSWORD=mock
MYSQL_ROOT_PASSWORD=root

# 对外端口
APP_PORT=8080

# 本地中文知识向量模型，无需额外 API Key
KNOWLEDGE_ENABLED=true
KNOWLEDGE_SEED_ON_STARTUP=true
KNOWLEDGE_COLLECTION=tech_knowledge_bge_zh_v1
KNOWLEDGE_TOP_K=3
KNOWLEDGE_MIN_SCORE=0.45

# P1 版本化题库与参考知识自动初始化
QUESTIONS_SEED_ON_STARTUP=true
QUESTIONS_INDEX_KNOWLEDGE=true

# P3：科大讯飞语音听写 IAT（独立于 DeepSeek；三项来自 IAT 服务控制台）
SPEECH_ENABLED=false
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
SPEECH_RETENTION_DAYS=30
SPEECH_TIMEOUT_SECONDS=240
